{
  "name": "dol-genba-security",
  "version": "1.6.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node serve.mjs",
    "dev:animal": "node serve.mjs --debug-unlock",
    "check": "node --check game.js",
    "test": "node test-game.cjs",
    "build": "node build.mjs",
    "sync:android": "npm run build && npx cap sync android",
    "sync:ios": "npm run build && npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "verify:android": "node scripts/verify-android.mjs",
    "build:android:debug": "npm run sync:android && npm run verify:android && node scripts/gradle.mjs :app:assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
